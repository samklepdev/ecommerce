{
  "name": "ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:integration:down": "docker compose -f docker-compose.test.yml down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "queue:dev": "tsx watch --env-file-if-exists=.env src/workers/btc-watcher.ts",
    "worker": "tsx --env-file-if-exists=.env src/workers/btc-watcher.ts",
    "fixture:supplier": "node scripts/fixture-supplier-server.mjs",
    "admin:promote": "tsx --env-file=.env scripts/bootstrap-admin.ts",
    "store:close": "tsx --env-file-if-exists=.env scripts/store-switch.ts close",
    "store:open": "tsx --env-file-if-exists=.env scripts/store-switch.ts open",
    "store:status": "tsx --env-file-if-exists=.env scripts/store-switch.ts status",
    "store:switch-setup": "tsx --env-file-if-exists=.env scripts/store-switch-setup.tsx",
    "geo:fetch": "node scripts/fetch-geo-db.mjs"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "argon2": "^0.41.1",
    "bip32": "^4.0.0",
    "bitcoinjs-lib": "^6.1.7",
    "bullmq": "^5.81.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.1",
    "leaflet": "^1.9.4",
    "maxmind": "^5.0.6",
    "next": "^16.2.12",
    "postgres": "^3.4.5",
    "qrcode.react": "^4.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "robots-parser": "^3.0.1",
    "tiny-secp256k1": "^2.2.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.24",
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.6",
    "uuid": "^11.1.1"
  }
}
